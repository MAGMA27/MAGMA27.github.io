---
import type { GetStaticPaths } from 'astro'
import CategoryPage from '@/components/pages/CategoryPage.astro'
import { getAllCategories } from '@/utils/content'

export const getStaticPaths = (async () => {
  const allCategories = await getAllCategories('en')

  return allCategories.map((category) => ({
    params: { category: category.slug },
    props: { category, locale: 'en' },
  }))
}) satisfies GetStaticPaths

interface Props {
  category: {
    name: string
    slug: string
    count: number
  }
  locale: 'en'
}

const { category } = Astro.props
---

<CategoryPage category={category} locale="en" />
