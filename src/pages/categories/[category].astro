---
import type { GetStaticPaths } from 'astro'
import CategoryPage from '@/components/pages/CategoryPage.astro'
import { getAllCategories } from '@/utils/content'
import { defaultLocale } from '@/i18n'

export const getStaticPaths = (async () => {
  const locale = defaultLocale
  const allCategories = await getAllCategories(locale)

  return allCategories.map((category) => ({
    params: { category: category.slug },
    props: { category, locale },
  }))
}) satisfies GetStaticPaths

interface Props {
  category: {
    name: string
    slug: string
    count: number
  }
  locale: typeof defaultLocale
}

const { category, locale } = Astro.props
---

<CategoryPage category={category} locale={locale} />
