---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import HomePage from '@/components/pages/HomePage.astro'
import { getSortedPosts } from '@/utils/content'
import appConfig from '@/config.json'
import { defaultLocale } from '@/i18n'

export const getStaticPaths = (async () => {
  const locale = defaultLocale
  const sortedPosts = await getSortedPosts(locale)
  const { perPage } = appConfig.posts
  const totalPage = Math.ceil(sortedPosts.length / perPage)

  return Array.from({ length: totalPage }).map((_, i) => ({
    params: { page: i === 0 ? undefined : `page/${i + 1}` },
    props: {
      currentPage: i + 1,
      totalPage,
      data: sortedPosts.slice(i * perPage, (i + 1) * perPage),
      locale,
    },
  }))
}) satisfies GetStaticPaths

interface Props {
  currentPage: number
  totalPage: number
  data: CollectionEntry<'posts'>[]
  locale: typeof defaultLocale
}

const { currentPage, totalPage, data, locale } = Astro.props
---

<HomePage currentPage={currentPage} totalPage={totalPage} data={data} locale={locale} />
