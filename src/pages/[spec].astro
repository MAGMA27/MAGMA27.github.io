---
import type { GetStaticPaths } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import SpecPage from '@/components/pages/SpecPage.astro'
import { defaultLocale, getContentSlug } from '@/i18n'

export const getStaticPaths = (async () => {
  const locale = defaultLocale
  const specList = await getCollection('spec', ({ data }) => data.locale === locale)

  return specList.map((md) => ({
    params: { spec: getContentSlug(md) },
    props: { md, locale },
  }))
}) satisfies GetStaticPaths

interface Props {
  md: CollectionEntry<'spec'>
  locale: typeof defaultLocale
}

const { md, locale } = Astro.props
---

<SpecPage md={md} locale={locale} />
