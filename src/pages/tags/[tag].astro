---
import type { GetStaticPaths } from 'astro'
import TagPage from '@/components/pages/TagPage.astro'
import { getAllTags } from '@/utils/content'
import { defaultLocale } from '@/i18n'

export const getStaticPaths = (async () => {
  const locale = defaultLocale
  const allTags = await getAllTags(locale)

  return allTags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tag, locale },
  }))
}) satisfies GetStaticPaths

interface Props {
  tag: {
    name: string
    slug: string
    count: number
  }
  locale: typeof defaultLocale
}

const { tag, locale } = Astro.props
---

<TagPage tag={tag} locale={locale} />
