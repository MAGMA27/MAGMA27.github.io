---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import { BackToTopFAB } from '@/components/BackToTopFAB'
import { ToastContainer } from '@/components/ToastContainer'
import { ModalStack } from '@/components/ui/modal'
import { localeHtmlLang, normalizeLocale, type Locale } from '@/i18n'
import '@/styles/global.css'

interface Props {
  title?: string
  description?: string
  image?: string
  locale?: Locale
}

const { title, description, image, locale: localeProp } = Astro.props
const locale = normalizeLocale(localeProp ?? Astro.currentLocale)
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <CommonHead title={title} description={description} image={image} locale={locale} />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
  </head>
  <body>
    <slot />

    <BackToTopFAB locale={locale} client:only="react" />
    <ToastContainer client:only="react" />
    <ModalStack client:only="react" />
  </body>
</html>
