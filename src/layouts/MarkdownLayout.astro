---
import Layout from './Layout.astro'
import { HeadGradient } from '@/components/head-gradient'
import Footer from '@/components/footer/Footer.astro'
import { Header } from '@/components/header/Header'
import { Provider } from '@/components/provider/Provider'
import { normalizeLocale, type Locale } from '@/i18n'
import { getLocalizedPath } from '@/utils/localized-path'
import 'katex/dist/katex.min.css'

interface Props {
  title: string
  description?: string
  image?: string
  mdTitle: string
  mdDescription: string
  mdSlug: string
  locale?: Locale
}

const { title, description, image, mdTitle, mdDescription, mdSlug, locale: localeProp } = Astro.props
const locale = normalizeLocale(localeProp ?? Astro.currentLocale)
const targetLocale = locale === 'en' ? 'zh-cn' : 'en'
const languagePath = await getLocalizedPath(Astro.url.pathname, locale, targetLocale)
---

<Layout title={title} description={description} image={image} locale={locale}>
  <Provider
    pathName={Astro.url.pathname}
    languagePath={languagePath}
    title={mdTitle}
    description={mdDescription}
    slug={mdSlug}
    client:only="react"
  />

  <Header locale={locale} languagePath={languagePath} client:only="react" />
  <main class="relative z-1 pt-16 min-h-main bg-primary">
    <HeadGradient client:idle />
    <div class="swup-transition-fade">
      <slot />
    </div>
  </main>
  <Footer locale={locale} />
</Layout>
