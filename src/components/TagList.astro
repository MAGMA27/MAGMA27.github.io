---
interface Props {
  tags: {
    name: string
    slug: string
    count?: number
  }[]
  locale?: import('@/i18n').Locale
}

const { tags, locale: localeProp } = Astro.props
const { localePath, normalizeLocale, t } = await import('@/i18n')
const locale = normalizeLocale(localeProp ?? Astro.currentLocale)
---

{
  tags.length === 0 ? (
    <div class="text-center text-sm">{t(locale, 'noTags')}</div>
  ) : (
    <div class="flex flex-wrap gap-2.5">
      {tags.map((tag) => (
        <a class="relative block group" href={localePath(locale, `/tags/${tag.slug}`)}>
          <div class="absolute -z-1 inset-0 rounded-lg bg-accent/10 group-hover:transition group-hover:bg-accent/20 group-hover:scale-105" />
          <div class="px-2.5 py-2 text-sm flex items-baseline gap-1 select-none">
            <span>{tag.name}</span>
            {tag.count && <span class="text-xs">({tag.count})</span>}
          </div>
        </a>
      ))}
    </div>
  )
}
