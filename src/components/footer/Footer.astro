---
import { ThemeSwitch } from './ThemeSwitch'
import { author, footer } from '@/config.json'
import { getAllPostsWordCount } from '@/utils/content'
import { RunningDays } from './RunningDays'
import Link from './Link.astro'
import { localePath, normalizeLocale, t, type Locale } from '@/i18n'

interface Props {
  locale?: Locale
}

const { locale: localeProp } = Astro.props
const locale = normalizeLocale(localeProp ?? Astro.currentLocale)
const sinceYear = new Date(footer.startTime).getFullYear()
const thisYear = new Date().getFullYear()
const copyDate = sinceYear === thisYear ? thisYear : `${sinceYear} - ${thisYear}`

const wordCount = await getAllPostsWordCount(locale)

const wordCountStr = (wordCount / 1000).toFixed(1) + 'k'
---

<footer class="relative z-1 py-8 px-4 md:px-8 border-t border-primary text-secondary text-sm">
  <div class="text-center space-y-2">
    <div>
      {t(locale, 'poweredBy')}
      <Link href="https://astro.build/">Astro</Link>
      {` ${t(locale, 'designedBy')} `}
      <Link href="https://github.com/lxchapu/astro-gyoza">Gyoza</Link>
    </div>
    <div class="space-x-1">
      <span>&copy;{copyDate} <Link href={localePath(locale, '/')}>{author.name}</Link>.</span>
      <Link href={localePath(locale, '/rss.xml')} data-no-swup>
        <i class="iconfont icon-rss"></i>
        <span>{t(locale, 'rss')}</span>
      </Link>
      <Link href="/sitemap-index.xml" data-no-swup>
        <i class="iconfont icon-map"></i>
        <span>{t(locale, 'sitemap')}</span>
      </Link>
    </div>
    <div>
      <RunningDays locale={locale} client:only="react" />
      <span class="select-none opacity-50">|</span>
      <span>{t(locale, 'wordCount', { count: wordCountStr })}</span>
    </div>
  </div>
  <div class="mt-4 flex justify-center">
    <ThemeSwitch locale={locale} client:only="react" />
  </div>
</footer>
