---
import { slugify } from '@/utils/content'
import { localePath, normalizeLocale, type Locale } from '@/i18n'

interface Props {
  tags: string[]
  category?: string
  class?: string
  locale?: Locale
}

const { tags, category, class: className, locale: localeProp } = Astro.props
const locale = normalizeLocale(localeProp ?? Astro.currentLocale)
---

<div class="flex flex-wrap gap-2 text-sm text-secondary" class:list={[className]}>
  {
    category && (
      <div>
        <i class="iconfont icon-folder" />
        <a
          class="hover:text-accent hover:underline underline-offset-2 decoration-dashed"
          href={localePath(locale, `/categories/${slugify(category)}`)}
        >
          {category}
        </a>
      </div>
    )
  }
  {
    tags.length > 0 && (
      <div>
        <i class="iconfont icon-hashtag" />
        {tags.map((tag, index) => (
          <>
            {index > 0 && <span>, </span>}
            <a
              class="hover:text-accent hover:underline underline-offset-2 decoration-dashed"
              href={localePath(locale, `/tags/${slugify(tag)}`)}
            >
              {tag}
            </a>
          </>
        ))}
      </div>
    )
  }
</div>
