---
import type { CollectionEntry } from 'astro:content'
import PostCard from './PostCard.astro'
import type { Locale } from '@/i18n'

interface Props {
  posts: CollectionEntry<'posts'>[]
  locale?: Locale
}

const { posts, locale } = Astro.props
---

<div>
  <ul class="-my-4">
    {
      posts.map((post) => (
        <li>
        <PostCard entry={post} locale={locale} />
        </li>
      ))
    }
  </ul>
</div>
