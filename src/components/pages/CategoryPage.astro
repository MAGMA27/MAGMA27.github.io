---
import PageLayout from '@/layouts/PageLayout.astro'
import { getOldestPosts, slugify } from '@/utils/content'
import Highlight from '@/components/Highlight.astro'
import Timeline from '@/components/Timeline.astro'
import { t, type Locale } from '@/i18n'

interface Props {
  category: {
    name: string
    slug: string
    count: number
  }
  locale: Locale
}

const { category, locale } = Astro.props
const oldestPosts = await getOldestPosts(locale).then((posts) => {
  return posts.filter((post) => post.data.category && slugify(post.data.category) === category.slug)
})
---

<PageLayout title={`${t(locale, 'categories')} · ${category.name}`} locale={locale}>
  <div class="max-w-[800px] mx-auto px-4 py-16">
    <header class="space-y-4 mb-8">
      <h1 class="text-4xl font-bold">
        {t(locale, 'categoryPrefix')}<Highlight>{category.name}</Highlight>
      </h1>
      <p>{t(locale, 'postsCount', { count: category.count })}</p>
    </header>
    <Timeline posts={oldestPosts} locale={locale} />
  </div>
</PageLayout>
